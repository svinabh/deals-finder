# Amazon Associates Product Advertising API credentials.
# Request PA-API access through the Amazon Associates account.
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=

# Database (Postgres), if used by the deployment.
DATABASE_URL=postgres://user:password@localhost:5432/dealsfinder

# Redis for caching/queue, if used by the deployment.
REDIS_URL=redis://localhost:6379/0

# Python path for server to spawn crawler.
PYTHON_PATH=python3

# Amazon Associates and approved Product Advertising API credentials.
AMAZON_AFFILIATE_TAG=
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=

# Optional EarnKaro link prefix. Configure only if an approved integration exists.
EARNKARO_PREFIX=

# Optional AI search-query understanding.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional seed terms for scheduled Amazon listing refreshes.
AMAZON_CRAWLER_QUERIES=smartphone,wireless earbuds,running shoes

# Runtime.
PORT=3000
