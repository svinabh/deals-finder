# ==================== LIVE MERCHANT DATA (optional) ====================
# Amazon Associates Product Advertising API credentials.
# Request PA-API access through the Amazon Associates account.
# In dono (access/secret) credentials hain — kabhi bhi frontend, git ya
# screenshot mein nahi rakhna. Sirf .env (local) ya Vercel env vars mein.
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=

# ==================== AI QUERY HELPER (optional, ₹0 options) ===========
# Koi bhi OpenAI-compatible Chat Completions endpoint chalega.
# Default (khaali chhod do) = OpenAI: https://api.openai.com/v1
#
# Free-tier examples:
#   Groq:      OPENAI_BASE_URL=https://api.groq.com/openai/v1
#              OPENAI_MODEL=llama-3.1-8b-instant
#   OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1
#              OPENAI_MODEL=+(koi free model, docs dekhen)
#   Gemini:    OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#              OPENAI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ==================== Optional extras ===================================
# EarnKaro link prefix. Configure only if an approved integration exists.
EARNKARO_PREFIX=

# Optional seed terms for scheduled Amazon listing refreshes.
AMAZON_CRAWLER_QUERIES=smartphone,wireless earbuds,running shoes

# Python path for local server to spawn crawler.
PYTHON_PATH=python3

# Runtime.
PORT=3000
